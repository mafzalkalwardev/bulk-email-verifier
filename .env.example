PORT=5000
JWT_SECRET=change_me_to_a_long_random_string
MONGO_URI=

# truemail = recommended (fast SMTP, ~15s per email)
# auto = same as truemail
# reacher = Docker only — slow on Gmail; use only if you need it
VERIFIER_ENGINE=truemail

GO_VERIFIER_URL=http://localhost:8080
VERIFIER_GO_PORT=8080
REACHER_URL=http://localhost:8081
REACHER_TIMEOUT_MS=60000
BULK_CONCURRENCY=3

# Free mode (no indus-license*.json file): bulk cap per account per UTC day.
# Single-address checks are not capped. A verified license file removes the cap.
# FREE_BULK_DAILY_LIMIT=25

# Local development only: skip the license check and run as licensed mode.
# INDUS_SKIP_LICENSE=1

# SMTP_PROXY=socks5://127.0.0.1:1080
