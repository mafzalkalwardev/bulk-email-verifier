PORT=5000
JWT_SECRET=change_me_to_a_long_random_string
MONGO_URI=

# auto = truemail-go first (fast), Reacher if Go down
# truemail = built-in Go only
# reacher = Docker only (docker compose up -d)
VERIFIER_ENGINE=auto

GO_VERIFIER_URL=http://localhost:8080
VERIFIER_GO_PORT=8080
REACHER_URL=http://localhost:8081
REACHER_TIMEOUT_MS=60000
BULK_CONCURRENCY=3

# SMTP_PROXY=socks5://127.0.0.1:1080
